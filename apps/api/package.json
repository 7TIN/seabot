{
  "name": "api",
"scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "start:crawler": "bun run src/modules/indexing/crawler.ts",
    "start:merge": "bun run scripts/export-dataset.ts",
    "index:typesense": "bun run src/modules/indexing/typesenseCreateCollection.ts && bun run src/modules/indexing/typesenseIndexDocs.ts",
    "index:qdrant": "bun run src/modules/qdrant/createCollection.ts && bun run src/modules/qdrant/indexDocs.ts",
    "index:all": "bun run index:typesense && bun run index:qdrant"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.23",
    "crawlee": "^3.16.0",
    "dotenv": "^17.3.1",
    "hono": "^4.12.5",
    "typesense": "^3.0.2"
  },
  "devDependencies": {
    "@apify/tsconfig": "^0.1.1",
    "@types/bun": "latest",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
