# Supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# # OpenAI (embeddings)
# OPENAI_API_KEY=

# # Anthropic (LLM)
# ANTHROPIC_API_KEY=

# Internal
PORT=3001
NODE_ENV=development

APIFY_LOCAL_STORAGE_DIR=./storage

EMBEDDED_DOCS_PATH="storage/key_value_stores/default/embedded_docs_qwen.json"
QDRANT_RECREATE=true
HF_TOKEN=token

# COLAB_NGROK_URL="ngrok url"
# COLAB_API_KEY=

# EMBEDDINGS_PROVIDER=colab
EMBEDDINGS_PROVIDER=local


# EMBEDDINGS_PROVIDER=huggingface
LLM_PROVIDER=gemini
GEMINI_API_KEY=geminikey
LLM_MODEL=gemini-2.5-flash

CRAWL_BASE_URL=https://hono.dev
CRAWL_DOCS_PATH=/docs

# CRAWL_SITEMAP_URL=https://hono.dev/sitemap.xml

# CRAWL_START_URLS=https://hono.dev/docs

# CRAWL_MAX_REQUESTS=2000

REDIS_URL=redis_url

CACHE_INDEX_VERSION=v1

SEARCH_CACHE_TTL_SEC=300

EMBEDDING_CACHE_TTL_SEC=86400

VECTOR_RESULTS_CACHE_TTL_SEC=300

AI_ANSWER_CACHE_TTL_SEC=180

REDIS_COMMAND_TIMEOUT_MS=400

REDIS_CACHE_TTL_JITTER_RATIO=0.1